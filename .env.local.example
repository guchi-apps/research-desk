# ローカル開発用の記入例。コピーして .env.local を作り、値を埋める（pnpm env:init）。
# 実シークレットはここに書かない。

# ローカルのMariaDB/MySQL（database.md参照）。DB名は app_research_desk。
DATABASE_URL="mysql://root:password@localhost:3306/app_research_desk"

# Supabase Auth（他アプリと共有のプロジェクト。値は1Passwordの共通アイテムを確認する）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 利用を許可するGoogleアカウント（カンマ区切り）。未設定の場合は全員ログイン不可
ALLOWED_GOOGLE_EMAILS=

# GUIの無いホスト・CIから認証の背後にある画面へ入るための開発専用バイパス。
# 空でも動くが、その場合 /api/dev/login は無効（常に404）になる。
CI_LOGIN_BYPASS_SECRET=dev-local-bypass-secret

# 手動の週次収集APIを保護する任意の開発用シークレット。
COLLECTION_CRON_SECRET=dev-collection-secret

# サーバー間連携API（/api/internal/*）の開発用シークレット。本番ではAIDEと共有する。
INTERNAL_API_KEY=dev-internal-api-key
