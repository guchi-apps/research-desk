// Clip は汎用クリップの配線確認用モデルとして残し、業界情報は専用モデルで管理する。

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Clip {
  id          String   @id @default(cuid())
  title       String
  url         String?  @db.Text
  content     String?  @db.Text
  source      String?
  collectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("clips")
}

enum IndustryBusiness {
  DELIVERY
  LOCKER
}

enum IndustryInformationType {
  NEW_PRODUCT
  COMPETITOR
  INTRODUCTION_CASE
  RECRUITMENT_PARTNERSHIP
  POLICY_SUBSIDY
  MARKET_STATISTICS
  USER_ISSUE
  CONSTRUCTION
  QUALITY_SAFETY
  PATENT
  OVERSEAS_CASE
  OTHER
}

enum IndustryImportance {
  HIGH
  MEDIUM
  REFERENCE
}

enum IndustryPeriodScope {
  IN_SCOPE
  PAST_30_DAYS_SUPPLEMENT
}

model IndustryInformation {
  id                 String                  @id @default(cuid())
  business           IndustryBusiness
  informationType    IndustryInformationType
  title              String
  originalUrl        String                  @db.Text
  normalizedUrl      String                  @unique @db.VarChar(512)
  urlHash            String                  @unique @db.Char(64)
  sourceName         String
  publisher          String?
  isPrimarySource    Boolean                 @default(false)
  publishedAt        DateTime?
  occurredAt         DateTime?
  collectedAt        DateTime                @default(now())
  content            String?                 @db.Text
  summary            String?                 @db.Text
  extractedMetrics   Json?
  implications       String?                 @db.Text
  importance         IndustryImportance      @default(REFERENCE)
  targetCompany      String?
  targetProduct      String?
  keywords           Json?
  tags               Json?
  periodScope        IndustryPeriodScope     @default(IN_SCOPE)
  canonicalId        String?
  canonical           IndustryInformation?   @relation("IndustryInformationCanonical", fields: [canonicalId], references: [id], onDelete: SetNull)
  relatedReprints    IndustryInformation[]  @relation("IndustryInformationCanonical")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([business, informationType])
  @@index([importance, publishedAt])
  @@index([periodScope, publishedAt])
  @@index([canonicalId])
  @@map("industry_information")
}
