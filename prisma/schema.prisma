// クリップ収集機能そのもののドメイン設計はこのIssue（プロジェクト初期化）のスコープ外。
// ここではPrismaの配線が通っていることを示す最小限のモデルだけを置く。実際の収集条件・
// 要約結果の保存形式は今後のIssueで拡張する。

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Clip {
  id          String   @id @default(cuid())
  title       String
  url         String?  @db.Text
  content     String?  @db.Text
  source      String?
  collectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("clips")
}

enum IndustryBusiness {
  DELIVERY
  LOCKER
}

enum IndustryImportance {
  HIGH
  MEDIUM
  REFERENCE
}

model IndustryItem {
  id                   String            @id @default(cuid())
  business             IndustryBusiness
  informationType      String
  title                String
  url                  String            @db.Text
  normalizedUrl        String            @db.VarChar(512)
  sourceName           String?
  publisher            String?
  publishedAt          DateTime?
  collectedAt          DateTime          @default(now())
  body                 String?           @db.Text
  summary              String?           @db.Text
  metrics              Json?
  implications         String?           @db.Text
  importance           IndustryImportance @default(REFERENCE)
  subjects             Json?
  tags                 Json?
  isSupplemental       Boolean           @default(false)
  primaryItemId        String?
  relatedUrls          Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  primaryItem          IndustryItem?     @relation("IndustryItemDuplicates", fields: [primaryItemId], references: [id])
  duplicates           IndustryItem[]    @relation("IndustryItemDuplicates")

  @@unique([normalizedUrl])
  @@index([business, publishedAt])
  @@index([business, informationType])
  @@index([importance, publishedAt])
  @@map("industry_items")
}

enum CollectionRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model CollectionRun {
  id              String            @id @default(cuid())
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?
  targetFrom      DateTime
  targetTo        DateTime
  supplementalFrom DateTime?
  status          CollectionRunStatus @default(RUNNING)
  fetchedCount    Int               @default(0)
  selectedCount   Int               @default(0)
  insertedCount   Int               @default(0)
  duplicateCount  Int               @default(0)
  failedCount     Int               @default(0)
  errors          Json?

  @@index([startedAt])
  @@map("collection_runs")
}
