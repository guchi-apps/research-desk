# サブPCの記事AI解析ポーラー（#79）の設定例。
# 実際は ~/.config/research-desk/analysis-worker.env へ chmod 600 で置く（リポジトリには
# 実シークレットを置かない）。値を変えたら `systemctl --user restart research-desk-analysis-poller`。

# 解析ジョブを取りに行く先。本番のResearch Desk。
RESEARCH_DESK_URL=https://research-desk.gucchii.com

# /api/internal/analysis/* のBearerトークン。本番の .env の ANALYSIS_WORKER_SECRET と同じ値
# （1Passwordの op://apps/research-desk/analysis-worker-secret が正）。
ANALYSIS_WORKER_SECRET=

# 以下は省略可（既定値のまま動く）。
# ANALYSIS_WORKER_HOST=subpc
# ANALYSIS_POLL_INTERVAL_SECONDS=60
# ANALYSIS_MAX_JOBS=1
# ANALYSIS_JOB_TIMEOUT_SECONDS=600
# CODEX_BIN=codex
# CODEX_MODEL=
