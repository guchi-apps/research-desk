# アプリ実行時に参照する環境変数（値は空。ローカル開発の記入例は .env.local.example を参照）

# MariaDB接続。本番は DB_* から scripts/construct-database-url.sh が組み立てる
DATABASE_URL=

# Supabase Auth（他アプリと共有のSupabaseプロジェクト）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 利用を許可するGoogleアカウント（カンマ区切り）。未設定の場合は全員ログイン不可
ALLOWED_GOOGLE_EMAILS=

# GUIの無いホスト・CIから認証の背後にある画面へ入るための開発/CI専用バイパス。
# NODE_ENV=production では常にこの導線ごと無効になる。本番の.envには設定しない
CI_LOGIN_BYPASS_SECRET=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=

# リリース通知（別チャンネル。未設定ならCI/デプロイと同じチャンネルへ送る）
SIGNALY_RELEASE_WEBHOOK_URL=

# 週次収集API。GitHub Actions等から `Authorization: Bearer` で送る。
COLLECTION_CRON_SECRET=

# サーバー間連携API（/api/internal/*）のBearerトークン。AIDEから週報を登録するときに使う。
# 同じ値をAIDE側の AIDE_RESEARCH_DESK_TOKEN へ設定する（片方だけ変えると連携が止まる）。
INTERNAL_API_KEY=

# 日次収集で新しく入った候補ができたことをaide-botへ知らせる（#41）。3つとも未設定なら通知は
# 送らず、収集自体はそのまま成功で返す。同一VPS上のaide-bot（3103）へlocalhostで届くため、
# AIDE_BOT_URLは外部公開URLではなく http://127.0.0.1:3103 を使う。
# 読み方はguchi-apps/aideの readAideBotConfig() に揃える。AIDE_BOT_TOKENはaide-bot側の
# NOTICE_INGEST_TOKENと同じ値（1Passwordで値を複製せず、提供側の参照をそのまま使う）。
AIDE_BOT_URL=
AIDE_BOT_TOKEN=
AIDE_BOT_EMAIL=

# 画像を社用メールに送る機能（#64）。ZIP化した画像をAIDEの内部APIへ転送する送信先・
# トークン。未設定の場合、画面から送信しようとすると503を返す（AIDE側の実装・設定と
# あわせてIssueで別途起票）。同じ値をAIDE側の環境変数へ設定する（片方だけ変えると連携が止まる）。
AIDE_IMAGE_MAIL_URL=
AIDE_IMAGE_MAIL_TOKEN=
